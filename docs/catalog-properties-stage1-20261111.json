  "migration_policy": {
    "preserve": [
      "product.id",
      "product.sku",
      "product.alias",
      "category aliases",
      "attribute_value.id",
      "attribute_value.alias",
      "attribute_value_category_canonical",
      "confirmed manual SEO"
    ],
    "automatic": [
      "exact duplicates with identical values after backup",
      "approved lexical aliases",
      "unambiguous numeric units",
      "explicit source-to-property mappings"
    ],
    "manual_review": [
      "different tyre sizes",
      "brand contradictions",
      "alternative and compatible sizes",
      "combined load/speed expressions",
      "ambiguous rim diameter",
      "country of manufacture",
      "solid mounting terminology"
    ],
    "forbidden": [
      "guess unknown values",
      "rewrite live prices or stock during migration",
      "regenerate URL from new name",
      "bulk activate all filter combinations for indexing",
      "treat service products as incomplete tyres"
    ]
  },
